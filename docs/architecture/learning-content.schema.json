{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ENGLERN lesson v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "language",
    "level",
    "title",
    "category",
    "source",
    "license",
    "sentences",
    "exercises"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "level": {
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "learningObjectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "originalText": {
      "type": "string",
      "maxLength": 100000
    },
    "sentences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "translation": {
            "type": "string"
          },
          "focusWords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "exercises": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "type": {
            "enum": [
              "READING",
              "LISTENING",
              "SENTENCE",
              "LISTEN_AND_REPEAT",
              "SHADOWING",
              "DICTATION",
              "COMPREHENSION",
              "RETELLING",
              "SPEAKING"
            ]
          },
          "sentenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "repeatCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "pauseSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "prompt": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "correctChoice": {
            "type": "integer",
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "COMPREHENSION",
                    "RETELLING",
                    "SPEAKING"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "prompt"
              ]
            }
          },
          {
            "if": {
              "required": [
                "choices"
              ]
            },
            "then": {
              "required": [
                "correctChoice"
              ]
            }
          },
          {
            "if": {
              "required": [
                "correctChoice"
              ]
            },
            "then": {
              "required": [
                "choices"
              ]
            }
          }
        ]
      }
    }
  }
}